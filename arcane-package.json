{
  "schemaVersion": 1,
  "id": "arcane-pm",
  "displayName": "Arcane PM",
  "version": "0.1.0",
  "entry": "index.html",
  "documents": [
    "index.html"
  ],
  "strategy": "static",
  "localAI": {
    "runtimes": [
      {
        "id": "ollama"
      },
      {
        "id": "onnx"
      },
      {
        "id": "stable-diffusion.cpp",
        "version": "master-929-3f8527a",
        "backend": "auto",
        "models": [
          {
            "id": "sd14",
            "name": "Stable Diffusion 1.4",
            "family": "sd",
            "resources": {
              "model": {
                "url": "https://huggingface.co/CompVis/stable-diffusion-v-1-4-original/resolve/c96766dd476698a0ece589565635fafc88ebecae/sd-v1-4.ckpt",
                "filename": "sd-v1-4.ckpt"
              }
            },
            "context": {},
            "defaults": {},
            "operations": [
              "txt2img",
              "img2img"
            ]
          },
          {
            "id": "sdxl-base-1.0",
            "name": "SDXL Base 1.0",
            "family": "sdxl",
            "resources": {
              "model": {
                "url": "https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0/resolve/462165984030d82259a11f4367a4eed129e94a7b/sd_xl_base_1.0.safetensors",
                "filename": "sd_xl_base_1.0.safetensors"
              }
            },
            "context": {},
            "defaults": {
              "width": 1024,
              "height": 1024
            },
            "operations": [
              "txt2img",
              "img2img"
            ]
          }
        ]
      }
    ]
  },
  "pwa": {
    "enabled": true,
    "manifest": {
      "id": "./",
      "display": "standalone",
      "background_color": "#fcfbf9",
      "theme_color": "#0a2e3c",
      "icons": [
        {
          "src": "assets/arcane-pm-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml",
          "purpose": "any"
        }
      ]
    },
    "offline": {
      "include": [],
      "exclude": []
    }
  },
  "include": [
    "index.html",
    "app.css",
    "assets",
    "modules"
  ],
  "exclude": [],
  "nativeResources": {
    "include": [
      "bridge",
      "native",
      "package.json"
    ],
    "exclude": []
  },
  "shared": [
    "browser-runtime"
  ]
}
