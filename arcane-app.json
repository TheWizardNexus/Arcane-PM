{
    "schemaVersion": 2,
    "id": "arcane-pm",
    "displayName": "Arcane PM",
    "description": "Organize project work, find complete sources, and prepare the next handoff.",
    "version": "0.1.0",
    "publisher": {
        "id": "the-wizard-nexus",
        "name": "TWiN"
    },
    "package": {
        "entry": "index.html",
        "documents": ["index.html"],
        "strategy": "static",
        "include": ["index.html", "app.css", "assets", "modules"],
        "exclude": [],
        "shared": ["browser-runtime"],
        "nativeResources": {
            "include": ["bridge", "native", "package.json"],
            "exclude": []
        },
        "pwa": {
            "enabled": true,
            "manifest": {
                "id": "./",
                "display": "standalone",
                "background_color": "#fcfbf9",
                "theme_color": "#0a2e3c",
                "icons": [
                    {
                        "src": "assets/arcane-pm-icon.svg",
                        "sizes": "any",
                        "type": "image/svg+xml",
                        "purpose": "any"
                    }
                ]
            }
        }
    },
    "native": {
        "type": "app",
        "launchContext": {
            "appControl": {
                "endpoint": "\\\\.\\pipe\\arcane-pm-control"
            }
        },
        "icon": "assets/arcane-pm-icon.png",
        "window": {
            "width": 1280,
            "height": 800,
            "resizable": true
        },
        "order": 0,
        "bundledApps": [],
        "localAI": {
            "runtimes": [
                {"id": "ollama"},
                {"id": "onnx"},
                {
                    "id": "stable-diffusion.cpp",
                    "version": "master-929-3f8527a",
                    "backend": "auto",
                    "models": ["sd14", "sdxl-base-1.0"]
                }
            ]
        },
        "services": [
            {"module": "bridge/codex-service.mjs", "options": {}},
            {"module": "bridge/hooks-service.mjs", "options": {}},
            {"module": "native/decision-service.mjs", "options": {}}
        ]
    },
    "requirements": {
        "arcaneProtocol": "arcane/1",
        "minimumCoreVersion": "0.8.12",
        "features": []
    },
    "targets": ["browser", "windows-x64"]
}
